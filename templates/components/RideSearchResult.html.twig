<div {{attributes}}>

	<div class="d-flex flex-row flex-wrap gap-2">
		<p class="text-start text-md-center mb-0">{{ ride.departureDate ? ride.departureDate|date('d/m/Y') : ''}}</p>
    <p class="text-start text-md-center mb-0">{{ ride.departureDate ? ride.departureDate|date('H:i') : ''}}</p>
		<p class="text-start text-md-center mb-0">{{ ride.departurePlace}}</p>
		<p class="text-start text-md-center mb-0">{{ ride.arrivalPlace}}</p>
	</div>

  	<twig:RideActions ride="{{ ride }}"/>
</div>

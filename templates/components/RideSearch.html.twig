<div
	{{ attributes }}>
	<!-- Barre de recherche -->
	<section class="container-fluid py-5">
		<div class="container card p-3">
			{{ form_start(form) }}

			{% if is_granted('ROLE_EMPLOYEE')%}
				<!-- Recherche par le staff ou l'admin -->
				<h1>Trajets</h1>

				<!-- ID et Statut -->
				<div class="row g-3 justify-content-around my-3">
					<div class="col-md-6">
						{{ form_label(form.id) }}
						{{ form_widget(form.id, {attr: {class: 'form-control'}}) }}
					</div>
					<div class="col-md-6">
						{{ form_label(form.status) }}
						{{ form_widget(form.status, {attr: {class: 'form-select'}}) }}
					</div>
				</div>

				<!-- Driver info -->
				<div class="row g-3 justify-content-around my-3">
					<div class="col-md-6">
						{{ form_label(form.driverId) }}
						{{ form_widget(form.driverId, {attr: {class: 'form-control'}}) }}
					</div>
					<div class="col-md-6">
						{{ form_label(form.lastName) }}
						{{ form_widget(form.lastName, {attr: {class: 'form-control'}}) }}
					</div>
				</div>

				<!-- Dates trajet-->
				<div class="row g-3 justify-content-around my-3">
					<div class="col-md-6">
						{{ form_label(form.departureDate) }}
						{{ form_widget(form.departureDate, {attr: {class: 'form-control'}}) }}
					</div>
					<div class="col-md-6">
						{{ form_label(form.arrivalDate) }}
						{{ form_widget(form.arrivalDate, {attr: {class: 'form-control'}}) }}
					</div>
				</div>

				<!-- Villes -->
				<div class="row g-3 justify-content-around my-3">
					<div class="col-md-6">
						{{ form_label(form.departurePlace) }}
						{{ form_widget(form.departurePlace, {attr: {class: 'form-control'}}) }}
					</div>
					<div class="col-md-6">
						{{ form_label(form.arrivalPlace) }}
						{{ form_widget(form.arrivalPlace, {attr: {class: 'form-control'}}) }}
					</div>
				</div>

				<!-- Autres dates -->
				<div class="row g-3 justify-content-around my-3">
					<div class="col-md-6">
						{{ form_label(form.createdAt) }}
						{{ form_widget(form.createdAt, {attr: {class: 'form-control'}}) }}
					</div>
					<div class="col-md-6">
						{{ form_label(form.updatedAt) }}
						{{ form_widget(form.updatedAt, {attr: {class: 'form-control'}}) }}
					</div>
				</div>

			{% else %}
				<!-- Recherche public ou client -->
				<div class="row align-items-end justify-content-around my-3">
					<div class="col-12 col-md-4 mb-3">
						{{ form_label(form.departureDate) }}
						{{ form_widget(form.departureDate, {attr: {class: 'form-control'}}) }}
						{{ form_errors(form.departureDate) }}
					</div>
					<div class="col-12 col-md-4 mb-3">
						{{ form_label(form.departurePlace) }}
						{{ form_widget(form.departurePlace, {attr: {class: 'form-control'}}) }}
						{{ form_errors(form.departurePlace) }}
					</div>
					<div class="col-12 col-md-4 mb-3">
						{{ form_label(form.arrivalPlace) }}
						{{ form_widget(form.arrivalPlace, {attr: {class: 'form-control'}}) }}
						{{ form_errors(form.arrivalPlace) }}
					</div>
				</div>
			{% endif %}

			<div class="row align-items-end justify-content-around my-3">
				<div class="col-12 col-md-4 mb-3">
					<button class="btn w-100" type="button" data-action="live#action" data-live-action-param="search">
						Rechercher
					</button>
				</div>

				<div class="col-12 mb-3">
					{{ form_errors(form) }}
				</div>

				<div class="col-12 col-md-4 mb-3">
					<div class="text-center">
						<a href="{{ path('app_ride_index') }}">Réinitialiser</a>
					</div>
				</div>

			</div>
			{{ form_end(form) }}
		</div>
	</section>

	<!-- Description ou Résultats -->
	<section class="container-fluid pb-5">
		<div class="container">

			{% if this.showDescription and not this.hasSearched %}
				<twig:DescriptionsHome/>
			{% endif %}

			<div class="row my-3">
				{% if this.hasSearched %}
					{% if this.results is empty %}
						<div class="col-12">
							<p>Aucun résultat</p>
						</div>
					{% else %}
						{% for ride in this.results %}
							<twig:RideCard ride="{{ ride }}"/>
						{% endfor %}
					{% endif %}

				{% endif %}
			</div>
		</div>
	</section>

</div>

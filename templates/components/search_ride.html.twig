<div {{ attributes }}>
    {{ form_start(form, {
        attr: {
            'data-action': 'live#action',
            'data-live-action-param': 'search'
        }
    }) }}

    {{ form_row(form.departureDate) }}
    {{ form_row(form.departurePlace) }}
    {{ form_row(form.arrivalPlace) }}

    <button type="submit">
        Rechercher
    </button>

    {{ form_end(form) }}

    <div>
        {% for ride in results %}
            <div>{{ ride.departurePlace }} → {{ ride.arrivalPlace }}</div>
        {% else %}
            <div>Aucun résultat</div>
        {% endfor %}
    </div>
</div>

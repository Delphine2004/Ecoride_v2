<div{{attributes}} class="d-flex flex-column flex-md-row justify-content-evenly gap-2 w-100">
	<div class="d-flex flex-column align-items-center">
		<div class="d-flex">
			<p class="text-start text-md-center mb-0">{{ ride.departureDate ? ride.departureDate|date('d/m/Y H:i') : ''}}</p>
		</div>
		<div class="d-flex flex-row flex-wrap gap-2">
			<p class="text-start text-md-center mb-0">{{ ride.departurePlace}}</p>
			<p class="text-start text-md-center mb-0">{{ ride.arrivalPlace}}</p>
		</div>
	</div>

	<div class="d-flex flex-column align-items-center">
		<p class="text-start text-md-center mb-0">{{ ride.status.value}}</p>
		<a href="{{ path('app_ride_show', {'id': ride.id}) }}">Plus de détails</a>
	</div>
</div>

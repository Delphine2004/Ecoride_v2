<div{{attributes}}>
	<div class="card flex-column flex-md-row justify-content-between align-items-center w-100 gap-3 p-3 m-2">
		{% if this.message %}

			<div class="alert alert-success">
				{{ this.message }}
			</div>

		{% endif %}


		<div class="d-flex flex-row flex-md-column justify-content-between flex-wrap gap-2">
			<p class="text-start text-md-center mb-0">Le
				{{ ride.departureDate ? ride.departureDate|date('d/m/Y') : ''}}</p>
			<p class="text-start text-md-center mb-0">à
				{{ ride.departureDate ? ride.departureDate|date('H:i') : ''}}</p>
		</div>
		<div class="d-flex flex-row flex-md-column justify-content-between flex-wrap gap-2">
			<p class="text-start text-md-center mb-0">{{ ride.departurePlace}}</p>
			<p class="text-start text-md-center mb-0">{{ ride.arrivalPlace}}</p>
		</div>
		<div class="d-flex flex-row flex-md-column justify-content-between flex-wrap gap-2">
			<p>{{ ride.duration}}</p>
			<a href="{{ path('app_ride_show', {'id': ride.id}) }}">Plus de détails</a>
		</div>

		<twig:RideActions :ride="ride" />

	</div>
</div>

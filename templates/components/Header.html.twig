<div{{attributes}}>
	<nav>
		<ul>
			<li>
				<a href="{{ path('app_home') }}">Rechercher</a>
			</li>

			{% if is_granted('ROLE_EMPLOYE')%}
				<li class="nav-item">
					<a class="nav-link" href="{{ path('app_dashboard_user') }}">Tableau de bord</a>
				</li>
				<li class="nav-item">
					<a class="nav-link" href="{{ path('app_user_show', { id: app.user.id }) }}">Mon compte staff</a>
				</li>
			{% endif %}
			{% if is_granted('ROLE_PASSENGER') and not is_granted('ROLE_EMPLOYE')%}
				<li class="nav-item">
					<a class="nav-link" href="{{ path('app_dashboard_client', { id: app.user.id }) }}">Mon compte client</a>
				</li>
			{% endif %}


			{% if is_granted('IS_AUTHENTICATED_FULLY')%}
				<li>
					<a href="{{ path('app_logout') }}">Deconnexion</a>
				</li>
			{% endif %}
			{% if not is_granted('IS_AUTHENTICATED_FULLY') %}
				<li>
					<a href="{{ path('app_login') }}">Connexion</a>
				</li>
			{% endif %}
		</ul>
	</nav>
</div>

<header{{attributes}} class="container-fluid">

	<nav class="navbar navbar-expand-lg">
		<div class="container-fluid">
			<a class="navbar-brand" href="{{ path('app_home') }}">
				<img src="{{ asset('img/logo-ecoridev2-light.png') }}" alt="Logo Ecoride"></a>
			<button class="navbar-toggler" type="button" data-bs-toggle="collapse" data-bs-target="#navbarNav" aria-controls="navbarNav" aria-expanded="false" aria-label="Toggle navigation">
				<span class="navbar-toggler-icon"></span>
			</button>
			<div class="collapse navbar-collapse justify-content-end gap-2" id="navbarNav">
				<ul class="navbar-nav">
					<li class="nav-item">
						<a class="nav-link" href="{{ path('app_home') }}">Rechercher</a>
					</li>

					{% if is_granted('ROLE_EMPLOYE')%}
						<li class="nav-item">
							<a class="nav-link" href="{{ path('app_dashboard_user') }}">Tableau de bord</a>
						</li>
						<li class="nav-item">
							<a class="nav-link" href="{{ path('app_user_show', { id: app.user.id }) }}">Mon compte</a>
						</li>
					{% endif %}
					{% if is_granted('ROLE_PASSENGER') and not is_granted('ROLE_EMPLOYE')%}
						<li class="nav-item">
							<a class="nav-link" href="{{ path('app_dashboard_client') }}">Mon compte</a>
						</li>
					{% endif %}


					{% if is_granted('IS_AUTHENTICATED_FULLY')%}
						<li class="nav-item">
							<a class="nav-link" href="{{ path('app_logout') }}">Deconnexion</a>
						</li>
					{% endif %}
					{% if not is_granted('IS_AUTHENTICATED_FULLY') %}
						<li class="nav-item">
							<a class="nav-link" href="{{ path('app_login') }}">Connexion</a>
						</li>
					{% endif %}
				</ul>
			</div>
		</div>
	</nav>

</header>

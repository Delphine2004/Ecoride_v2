<div{{attributes}}>
	<!-- Barre de recherche -->
	<section class="container-fluid py-5">
		<div class="container p-3">
			<div class="row justify-content-center">

				<div class="col-12 col-md-10 col-lg-8 card">
					{{ form_start(form, {'attr': {'novalidate':  true}}) }}
					<h1>Recherche réservation</h1>

					<div class="row g-3 justify-content-around my-3">
						<div class="col-md-4">
							{{ form_label(form.id) }}
							{{ form_widget(form.id, {attr: {class: 'form-control'}}) }}
						</div>
						<div class="col-md-4">
							{{ form_label(form.rideId) }}
							{{ form_widget(form.rideId, {attr: {class: 'form-control'}}) }}
						</div>
						<div class="col-md-4">
							{{ form_label(form.passengerId) }}
							{{ form_widget(form.passengerId, {attr: {class: 'form-control'}}) }}
						</div>
					</div>

					<div class="row g-3 justify-content-around my-3">
						<div class="col-md-4">
							{{ form_label(form.departureDate) }}
							{{ form_widget(form.departureDate, {attr: {class: 'form-control'}}) }}
						</div>
						<div class="col-md-4">
							{{ form_label(form.departurePlace) }}
							{{ form_widget(form.departurePlace, { attr: {class: 'form-control'}}) }}
						</div>
						<div class="col-md-4">
							{{ form_label(form.arrivalPlace) }}
							{{ form_widget(form.arrivalPlace, {attr: {class: 'form-control'}}) }}
						</div>
					</div>

					<div class="row g-3 justify-content-around my-3">
						<div class="col-md-6">
							{{ form_label(form.email) }}
							{{ form_widget(form.email, {attr: {class: 'form-control'}}) }}
						</div>
						<div class="col-md-6">
							{{ form_label(form.lastName) }}
							{{ form_widget(form.lastName, { attr: {class: 'form-control'}}) }}
						</div>
					</div>

					<div class="row g-3 justify-content-around my-3">
						<div class="col-md-4">
							{{ form_label(form.status) }}
							{{ form_widget(form.status, {attr: {class: 'form-select'}}) }}
						</div>
						<div class="col-md-4">
							{{ form_label(form.createdAt) }}
							{{ form_widget(form.createdAt, {attr: {class: 'form-control'}}) }}
						</div>
						<div class="col-md-4">
							{{ form_label(form.updatedAt) }}
							{{ form_widget(form.updatedAt, { attr: {class: 'form-control'}}) }}
						</div>
					</div>

					<div class="row justify-content-center my-3">
						<div class="col-12 col-md-4 mb-3">
							<button class="btn w-100" type="button" data-action="live#action" data-live-action-param="search">Rechercher</button>
						</div>

						<div class="col-12 mb-3">
							{{ form_errors(form) }}
						</div>

						<div class="col-12 col-md-4 mb-3">
							<div class="text-center">
								<a href="{{ path('app_booking_index') }}">Réinitialiser</a>
							</div>
						</div>
					</div>

					{{ form_end(form) }}
				</div>
        
			</div>
		</div>
	</section>

	<!-- Résultats -->
	<section class="container-fluid pb-5">
		<div class="container">

			<div class="row justify-content-center align-items-center my-4">

				{% for booking in this.results %}
					<div class="col-12 col-md-10 col-lg-8">
						<twig:BookingCard :booking="booking"/>
					</div>
				{% else %}
					<div class="col-12 col-md-10 col-lg-8">
						<p class="text-center m-2">
							Aucune réservation ne correspond à la recherche.
						</p>
					</div>
				{% endfor %}

			</div>
		</div>
	</section>
</div>

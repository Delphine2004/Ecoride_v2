<div{{attributes}}>
	<div class="card flex-column flex-md-row justify-content-between align-item-center gap-3 p-3 m-2">

		<div class="d-flex flex-column align-items-center">
			<div class="d-flex">
				<p class="text-start text-md-center mb-0">{{ ride.departureDate ? ride.departureDate|date('d/m/Y') : ''}}
					à Heure</p>
			</div>
			<div class="d-flex flex-row flex-wrap gap-2">
				<p class="text-start text-md-center mb-0">{{ ride.departurePlace}}</p>
				<p class="text-start text-md-center mb-0">{{ ride.arrivalPlace}}</p>
			</div>
		</div>

		<div class="d-flex flex-column align-items-center">
			<p class="text-start text-md-center mb-0">{{ ride.status.value}}</p>
			<a href="{{ path('app_ride_show', {'id': ride.id}) }}">Plus de détails</a>
		</div>


		{% if ride.status == constant('App\\Enum\\RideStatus::CONFIRMED') and ride.departureDate|date('Y-m-d') == 'now'|date('Y-m-d')%}
			<div class="d-flex flex-column flex-md-row">
				<button class="btn" {{ live_action('start') }}>
					Démarrer
				</button>
			</div>
		{% elseif ride.status == constant('App\\Enum\\RideStatus::CONFIRMED') %}
			<div class="d-flex flex-column flex-md-row">
				<button class="btn" {{ live_action('cancel') }}>
					Annuler
				</button>
			</div>
		{% elseif ride.status == constant('App\\Enum\\RideStatus::RUNNING') %}
			<div class="d-flex flex-column flex-md-row">
				<button class="btn" {{ live_action('stop') }}>
					Arrêter
				</button>
			</div>
		{% elseif ride.status == constant('App\\Enum\\RideStatus::PENDING') %}
			<div class="d-flex flex-column flex-md-row">
				<p class="text-start text-md-center mb-0">En attente de confirmation de tous les passagers</p>
			</div>
		{% endif %}

	</div>
</div>

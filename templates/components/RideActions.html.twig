<div{{attributes}}>

	{% if ride.status == constant('App\\Enum\\RideStatus::CONFIRMED') and ride.departureDate|date('Y-m-d') == 'now'|date('Y-m-d') and (
        ride.driver == this.user
        or is_granted('ROLE_EMPLOYEE')
    )%}
		<div class="d-flex flex-column flex-md-row">
			<button class="btn" {{ live_action('start') }}>
				Démarrer
			</button>
		</div>
	{% elseif ride.status == constant('App\\Enum\\RideStatus::CONFIRMED') 
  and ride.departureDate|date('Y-m-d') > 'now'|date('Y-m-d') 
  and ride.driver != this.user and not is_granted('ROLE_EMPLOYEE') %}
		<div class="d-flex flex-column flex-md-row">
			<button class="btn" {{ live_action('book', { ride: ride.id } ) }}>
				Réserver
			</button>
		</div>
	{% elseif ride.status == constant('App\\Enum\\RideStatus::CONFIRMED') and (
        ride.driver == this.user
        or is_granted('ROLE_EMPLOYEE')
    )%}
		<div class="d-flex flex-column flex-md-row">
			<button class="btn" {{ live_action('cancel') }}>
				Annuler
			</button>
		</div>
	{% elseif ride.status == constant('App\\Enum\\RideStatus::RUNNING') and (
        ride.driver == this.user
        or is_granted('ROLE_EMPLOYEE')
    )%}
		<div class="d-flex flex-column flex-md-row">
			<button class="btn" {{ live_action('stop') }}>
				Arrêter
			</button>
		</div>
	{% elseif ride.status == constant('App\\Enum\\RideStatus::PENDING') and (
        ride.driver == this.user
        or is_granted('ROLE_EMPLOYEE')
    )%}
		<div class="d-flex flex-column flex-md-row">
			<p class="text-start text-md-center mb-0">...</p>
		</div>
	{% endif %}
  
	{% if message %}
		<div class="alert alert-danger">
			{{ message }}
		</div>
	{% endif %}
</div>

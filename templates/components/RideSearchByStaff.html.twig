<div{{attributes}}>

	<!-- Barre de recherche -->
	<section class="container-fluid">
		<div class="container">
			<div class="row justify-content-center">
				<div class="col-12 col-md-10 col-lg-8">
					<h1>Recherche trajet</h1>
					{{ form_start(form, {'attr': {'novalidate':  true}}) }}
					<!-- ID et Statut -->
					<div class="row g-3 justify-content-around my-3">
						<div class="col-md-6">
							{{ form_label(form.id) }}
							{{ form_widget(form.id, {attr: {class: 'form-control'}}) }}
						</div>
						<div class="col-md-6">
							{{ form_label(form.status) }}
							{{ form_widget(form.status, {attr: {class: 'form-select'}}) }}
						</div>
					</div>

					<!-- Driver info -->
					<div class="row g-3 justify-content-around my-3">
						<div class="col-md-6">
							{{ form_label(form.driverId) }}
							{{ form_widget(form.driverId, {attr: {class: 'form-control'}}) }}
						</div>
						<div class="col-md-6">
							{{ form_label(form.lastName) }}
							{{ form_widget(form.lastName, {attr: {class: 'form-control'}}) }}
						</div>
					</div>

					<!-- Dates trajet-->
					<div class="row g-3 justify-content-around my-3">
						<div class="col-md-6">
							{{ form_label(form.departureDate) }}
							{{ form_widget(form.departureDate, {attr: {class: 'form-control'}}) }}
						</div>
						<div class="col-md-6">
							{{ form_label(form.arrivalDate) }}
							{{ form_widget(form.arrivalDate, {attr: {class: 'form-control'}}) }}
						</div>
					</div>

					<!-- Villes -->
					<div class="row g-3 justify-content-around my-3">
						<div class="col-md-6">
							{{ form_label(form.departurePlace) }}
							{{ form_widget(form.departurePlace, {attr: {class: 'form-control'}}) }}
						</div>
						<div class="col-md-6">
							{{ form_label(form.arrivalPlace) }}
							{{ form_widget(form.arrivalPlace, {attr: {class: 'form-control'}}) }}
						</div>
					</div>

					<!-- Autres dates -->
					<div class="row g-3 justify-content-around my-3">
						<div class="col-md-6">
							{{ form_label(form.createdAt) }}
							{{ form_widget(form.createdAt, {attr: {class: 'form-control'}}) }}
						</div>
						<div class="col-md-6">
							{{ form_label(form.updatedAt) }}
							{{ form_widget(form.updatedAt, {attr: {class: 'form-control'}}) }}
						</div>
					</div>

          <!-- Bouton de recherche -->
					<div class="row justify-content-center my-3">
						<div class="col-12 col-md-4 mb-3">
							<button class="btn w-100" type="button" data-action="live#action" data-live-action-param="search">Rechercher</button>
						</div>

						<div class="col-12 mb-3">
							{{ form_errors(form) }}
						</div>

						<div class="col-12 col-md-4 mb-3">
							<div class="text-center">
								<a href="{{ path('app_ride_index') }}">Réinitialiser</a>
							</div>
						</div>
					</div>

					{{ form_end(form) }}
				</div>
			</div>
		</div>
	</section>

	<!-- Messages -->
	<section class="container-fluid py-5">
		{% for label, messages in app.flashes %}
			<div class="container">
				{% for message in messages %}
					<p class="fw-bold text-center m-3 alert alert-{{ label }}">
						{{ message }}
					</p>
				{% endfor %}
			</div>
		{% endfor %}
	</section>

	<!-- Résultats -->
	<section class="container-fluid">
		<div class="container">
			<div class="row justify-content-center align-items-center my-4">
				<div class="col-12 col-md-10 col-lg-8">
					{% for ride in this.results %}
						<twig:RideCard :ride="ride"/>
					{% else %}
						<p class="text-center m-2">
							Aucun trajet ne correspond à la recherche.
						</p>
					{% endfor %}
				</div>
			</div>
		</div>
	</section>
</div>

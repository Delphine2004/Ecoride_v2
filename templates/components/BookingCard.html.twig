<div{{attributes}}>
	<div class="card flex-column flex-md-row justify-content-between align-items-center w-100 gap-3 p-3 my-2">

		<div class="d-flex flex-row flex-md-column justify-content-between flex-wrap gap-2">
			<p class="text-center text-md-start mb-0">Le
				{{ booking.ride.departureDate ? booking.ride.departureDate|date('d/m/Y') : ''}}
				à
				{{ booking.ride.departureDate ? booking.ride.departureDate|date('H:i') : ''}}</p>
			<p class="text-center text-md-start mb-0">{{ booking.ride.departurePlace}}
				-
				{{ booking.ride.arrivalPlace}}</p>
		</div>
		
		<div class="d-flex flex-row flex-md-column justify-content-between flex-wrap gap-2">
			<p class="text-center text-md-start mb-0">{{ booking.ride.duration}}</p>
			<a href="{{ path('app_booking_show', {'id': booking.id}) }}" target="_blank">Plus de détails</a>
		</div>

		<twig:BookingActions :booking="booking"/>

	</div>
</div>

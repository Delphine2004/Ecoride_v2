<div{{attributes}}>
	<div class="card flex-column flex-md-row justify-content-between align-items-center w-100 gap-3 p-3 m-2">
		{% if this.message %}

			<div>
				<p>{{ this.message }}</p>
			</div>

		{% endif %}


		<div class="d-flex flex-row flex-md-column justify-content-between flex-wrap gap-2">
			<p class="text-start text-md-center mb-0">Le
				{{ booking.ride.departureDate ? booking.ride.departureDate|date('d/m/Y') : ''}}</p>
			<p class="text-start text-md-center mb-0">à
				{{ booking.ride.departureDate ? booking.ride.departureDate|date('H:i') : ''}}</p>
		</div>
		<div class="d-flex flex-row flex-md-column justify-content-between flex-wrap gap-2">
			<p class="text-start text-md-center mb-0">{{ booking.ride.departurePlace}}</p>
			<p class="text-start text-md-center mb-0">{{ booking.ride.arrivalPlace}}</p>
		</div>
		<div class="d-flex flex-row flex-md-column justify-content-between flex-wrap gap-2">
			<a href="{{ path('app_booking_show', {'id': booking.id}) }}">Plus de détails</a>
		</div>

		<twig:BookingActions booking="{{ booking }}"/>

	</div>
</div>

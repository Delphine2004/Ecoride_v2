<div{{ attributes }}>
<div class="card flex-column justify-content-between align-items-center w-100 gap-3 p-3 my-2">

  <div class="d-flex gap-4 justify-content-between w-100">
    <div class="d-flex flex-md-column justify-content-between flex-wrap gap-2">
      <p class="text-center text-md-start mb-0">Le {{ booking.ride.departureDate ? booking.ride.departureDate|date('d/m/Y') : '' }} à {{ booking.ride.departureDate ? booking.ride.departureDate|date('H:i') : '' }}</p>
      <p class="text-center text-md-start mb-0">{{ booking.ride.departurePlace }} - {{ booking.ride.arrivalPlace }}</p>
    </div>
		
    <div class="d-flex flex-md-column justify-content-between flex-wrap gap-2">
      <p class="text-center text-md-start mb-0">{{ booking.ride.duration }}</p>
      <p class="text-center text-md-start mb-0">{{ booking.ride.price }}</p>
    </div>

    <div class="d-flex flex-md-column justify-content-between flex-wrap gap-2">
      <a href="{{ path('app_booking_show', {'id': booking.id}) }}" target="_blank">Plus de détails</a>
    </div>
  </div>

  <div class="d-flex">
    <twig:BookingActions :booking="booking"/>
  </div>
</div>
</div>

<div{{attributes}}>
	<div class="card flex-column flex-md-row justify-content-between align-item-center gap-3 p-3 m-2">

		<div class="d-flex flex-column align-items-center">
			<div class="d-flex">
				<p class="text-start text-md-center mb-0">{{ booking.ride.departureDate ? booking.ride.departureDate|date('d/m/Y') : ''}}
					à Heure</p>
			</div>
			<div class="d-flex  flex-row flex-wrap gap-2">
				<p class="text-start text-md-center mb-0">{{ booking.ride.departurePlace}}</p>
				<p class="text-start text-md-center mb-0">{{ booking.ride.arrivalPlace}}</p>
			</div>
		</div>

		<div class="d-flex flex-column align-items-center">
			<p class="text-start text-md-center mb-0">{{ booking.status.value}}</p>
			<a href="{{ path('app_booking_show', {'id': booking.id}) }}">Plus de détails</a>
		</div>


		{% if booking.status == constant('App\\Enum\\BookingStatus::CONFIRMED') and booking.ride.departureDate|date('Y-m-d') == 'now'|date('Y-m-d')%}
			<div class="d-flex flex-column flex-md-row">
				<p class="text-start text-md-center mb-0">En attente ...</p>
			</div>
		{% elseif booking.status == constant('App\\Enum\\BookingStatus::CONFIRMED') %}
			<div class="d-flex flex-column flex-md-row">
				<button class="btn" {{ live_action('cancel') }}>
					Annuler
				</button>
			</div>
		{% elseif booking.status == constant('App\\Enum\\BookingStatus::RUNNING') %}
			<div class="d-flex flex-column flex-md-row">
				<p class="text-start text-md-center mb-0">Le trajet a demarré</p>
			</div>
		{% elseif booking.status == constant('App\\Enum\\BookingStatus::PENDING') %}
			<div class="d-flex flex-column flex-md-row">
				<button class="btn" {{ live_action('finalize') }}>
					Tout est OK
				</button>
				<button class="btn" {{ live_action('report') }}>
					Signaler
				</button>
			</div>
		{% elseif booking.status == constant('App\\Enum\\BookingStatus::REPORTED')  %}
			<div class="d-flex flex-column flex-md-row">
				<button class="btn" {{ live_action('finalize') }}>
					Finaliser
				</button>
				<button class="btn" {{ live_action('refund') }}>
					Rembourser
				</button>
			</div>
		{% endif %}

	</div>
</div>

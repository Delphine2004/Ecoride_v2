{% extends 'base.html.twig' %}

{% block title %}Ride
{% endblock %}

{% block body %}
	<main class="py-5">
		<section class="container-fluid">
			<div class="container">
				<div class="row justify-content-center">
					<div class="col-12">
						<h1>Récapitulatif</h1>
					</div>

					<!-- Partie trajet -->
					<div class="col-12 col-md-8">
						<div class="card justify-content-around h-100 flex-column shadow-sm p-4 mb-4">

							<!-- ref + statut réservation -->
							<div class="d-flex flex-column flex-md-row justify-content-between align-items-center p-2">
								<h2 class="my-2">Trajet #{{ ride.id }}</h2>
								<h3 class="my-2">{{ ride.status.value }}</h3>
							</div>

							<!-- Dates et heures -->
							<div class="d-flex flex-column p-2">
								<div class="d-flex flex-column flex-md-row justify-content-md-between">
									<p>Depart de {{ ride.departurePlace}}</p>
									<p>le {{ ride.departureDate ? ride.departureDate|date('d/m/Y') : ''}}</p>
									<p>à {{ ride.departureDate ? ride.departureDate|date('H:i') : ''}}</p>
								</div>

								<div class="d-flex flex-column flex-md-row justify-content-md-between">
									<p>Arrivée à {{ ride.arrivalPlace}}</p>
									<p>le {{ ride.departureDate ? ride.departureDate|date('d/m/Y') : ''}}</p>
									<p>à {{ ride.departureDate ? ride.departureDate|date('H:i') : ''}}</p>
								</div>
							</div>

							<!-- Voiture -->
							<div class="d-flex flex-column flex-md-row justify-content-md-between p-2">
								<div class="d-flex flex-row gap-2">
									<p>{{ ride.car.model}}</p>
									<p>{{ ride.car.brand.value}}</p>
								</div>
								<div class="d-flex flex-row gap-2">
									<p>{{ ride.car.color.value}}</p>
									<p>{{ ride.car.power.value}}</p>
								</div>
								<div class="d-flex flex-row gap-2">
									<p>{{ ride.car.registrationNumber}}</p>
								</div>
								{% if not is_granted('ROLE_EMPLOYEE') %}
									<div class="flex">
										<a class="btn" href="{{ path('app_ride_edit', {'id': ride.id}) }}">Modifier voiture</a>
									</div>
								{% endif %}
							</div>

							<!-- Info création -->
							<div class="d-flex flex-column flex-md-row p-2">
								<p>Créé le : {{ ride.createdAt ? ride.createdAt|date('Y-m-d') : '' }} à {{ ride.createdAt ? ride.createdAt|date('H:i:s') : '' }}</p>
							</div>

							<!-- Boutons d'action -->
							<div class="d-flex flex-column flex-md-row p-2">
								<twig:RideActions :ride="ride"/>
							</div>
						</div>
					</div>

					<!-- Partie conducteur -->
					<div class="col-12 col-md-4">

						<div class="card justify-content-around h-100 shadow-sm p-4 mb-4">
							<h2 class="my-2">Conducteur
							</h2>
							<div class="d-flex flex-column align-items-center">
								<p>{{ ride.driver.login }}
									Login</p>
								<p>Note</p>
								<a class="btn w-100" href="">Avis</a>
								{% if is_granted('ROLE_EMPLOYEE') %}
									<a class="btn w-100" href="{{ path('app_user_show', {'id': ride.driver.id}) }}"target="_blank">Voir</a>
								{% endif %}
							</div>
						</div>

					</div>

					<!-- Partie passagers -->
					<div class="col-12">

						<div class="card justify-content-around h-100 shadow-sm p-4 mb-4">
							<h2 class="my-2">Passager(s)
							</h2>
							{% for booking in ride.rideBookings %}
								<div class="d-flex flex-column align-items-center">
									<p>{{ booking.passenger.login }}</p>
									<p>{{ booking.passenger.email }}</p>
									{% if is_granted('ROLE_EMPLOYEE') %}
										<a class="btn w-100" href="{{ path('app_user_show', {'id': booking.passenger.id}) }}" target="_blank">Voir</a>
									{% endif %}
								</div>
							{% else %}
								<p class="text-center">Aucun passager</p>
							{% endfor %}
						</div>
					</div>

				</div>
			</div>
		</section>
	</main>
{% endblock %}

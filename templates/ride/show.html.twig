{% extends 'base.html.twig' %}

{% block title %}Ride{% endblock %}

{% block body %}
    <h1>Ride</h1>

    <table class="table">
        <tbody>
            <tr>
                <th>Id</th>
                <td>{{ ride.id }}</td>
            </tr>
            <tr>
                <th>DepartureDate</th>
                <td>{{ ride.departureDate ? ride.departureDate|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>DeparturePlace</th>
                <td>{{ ride.departurePlace }}</td>
            </tr>
            <tr>
                <th>ArrivalDate</th>
                <td>{{ ride.arrivalDate ? ride.arrivalDate|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>ArrivalPlace</th>
                <td>{{ ride.arrivalPlace }}</td>
            </tr>
            <tr>
                <th>Price</th>
                <td>{{ ride.price }}</td>
            </tr>
            <tr>
                <th>AvailableSeats</th>
                <td>{{ ride.availableSeats }}</td>
            </tr>
            <tr>
                <th>Status</th>
                <td>{{ ride.status }}</td>
            </tr>
            <tr>
                <th>Commission</th>
                <td>{{ ride.commission }}</td>
            </tr>
            <tr>
                <th>CreatedAt</th>
                <td>{{ ride.createdAt ? ride.createdAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
            <tr>
                <th>UpdatedAt</th>
                <td>{{ ride.updatedAt ? ride.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
            </tr>
        </tbody>
    </table>

    <a href="{{ path('app_ride_index') }}">back to list</a>

    <a href="{{ path('app_ride_edit', {'id': ride.id}) }}">edit</a>

    {{ include('ride/_delete_form.html.twig') }}
{% endblock %}

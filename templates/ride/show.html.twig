{% extends 'base.html.twig' %}

{% block title %}Récapitulatif trajet
{% endblock %}

{% block body %}
  <main class="py-5">
    <section class="container-fluid">
      <div class="container">
        <div
          class="row justify-content-center"
        >

          <!-- Partie trajet -->
          <div class="col-12 mb-4">
            <div class="card justify-content-around h-100 flex-column shadow-sm p-4 mb-4">

              <h1 class="mb-2">Récapitulatif trajet</h1>

              <div
                class="d-flex flex-column p-2"
              >
                <!-- Dates et heures -->
                <div class="d-flex flex-column flex-md-row justify-content-md-between align-items-center mb-2">
                  <p class="mb-0">Depart de
                    {{ ride.departurePlace }}</p>
                  <p class="mb-0">le
                    {{ ride.departureDate ? ride.departureDate|date('d/m/Y') : '' }}
                    à
                    {{ ride.departureDate ? ride.departureDate|date('H:i') : '' }}</p>
                </div>

                <div class="d-flex flex-column flex-md-row justify-content-md-between align-items-center mb-2">
                  <p class="mb-0">Arrivée à
                    {{ ride.arrivalPlace }}</p>
                  <p class="mb-0">le
                    {{ ride.arrivalDate ? ride.arrivalDate|date('d/m/Y') : '' }}
                    à
                    {{ ride.arrivalDate ? ride.arrivalDate|date('H:i') : '' }}</p>
                </div>
                <div class="d-flex flex-column flex-md-row justify-content-md-between align-items-center mb-2">
                  <p class="mb-0">{{ ride.price }} crédits</p>
                </div>


                {% if is_granted('IS_AUTHENTICATED_FULLY') and (ride.driver == app.user or is_granted('ROLE_EMPLOYEE')) %}
                  <!-- ref + statut réservation -->
                  <div class="d-flex flex-column flex-md-row justify-content-between align-items-center mb-2">
                    <p class="mb-0">Trajet #{{ ride.id }}</p>
                    <p class="mb-0">{{ ride.status.value }}</p>
                  </div>

                  <!-- Info création -->
                  <div class="d-flex flex-column flex-md-row mb-2">
                    <p class="mb-0">Créé le :
                      {{ ride.createdAt ? ride.createdAt|date('Y-m-d') : '' }}
                      à
                      {{ ride.createdAt ? ride.createdAt|date('H:i:s') : '' }}</p>
                  </div>

                  <!-- Boutons d'action -->
                  <div class="d-flex flex-column flex-md-row justify-content-center mb-2">
                    <twig:RideActions :ride="ride"/>
                  </div>
                {% endif %}
              </div>
            </div>
          </div>

          <!-- Partie conducteur -->
          <div class="col-12 col-md-6 mb-4">
            <div class="card justify-content-between h-100 shadow-sm p-4 mb-4">
              <h2 class="mb-2">Conducteur
              </h2>
              <div class="d-flex flex-column align-items-center">
                <p class="mb-0">{{ ride.driver.login }}</p>
                <p class="mb-0">Note</p>
              </div>
              <div class="d-flex flex-column flex-md-row align-items-center gap-2">
                <a class="btn w-100" href="">Avis</a>
                {% if is_granted('ROLE_EMPLOYEE') %}
                  <a class="btn w-100" href="{{ path('app_user_show', {'id': ride.driver.id}) }}" target="_blank">Voir</a>
                {% endif %}
              </div>
            </div>
          </div>

          <!-- Voiture -->
          <div class="col-12 col-md-6 mb-4">
            <div class="card justify-content-between h-100 shadow-sm p-4 mb-4">
              <h2 class="mb-2">Voiture</h2>
              <div class="d-flex flex-column p-4">
                <div class="d-flex flex-row justify-content-center gap-2 p-2">
                  <p class="mb-0">{{ ride.car.model }}</p>
                  <p class="mb-0">{{ ride.car.brand.value }}</p>
                </div>
                <div class="d-flex flex-row justify-content-center gap-2 p-2">
                  <p class="mb-0">{{ ride.car.color.value }}</p>
                  <p class="mb-0">{{ ride.car.power.value }}</p>
                </div>
                <div class="d-flex flex-row justify-content-center gap-2 p-2">
                  <p class="mb-0">{{ ride.car.registrationNumber }}</p>
                </div>
              </div>
              {% if is_granted('IS_AUTHENTICATED_FULLY') and ride.driver == app.user %}
                <div class="d-flex justify-content-center">
                  <a class="btn w-100" href="{{ path('app_ride_edit', {'id': ride.id}) }}">Modifier voiture</a>
                </div>
              {% endif %}
            </div>
          </div>

          <!-- Partie passagers -->
          <div class="col-12 mb-4">
            <div class="card justify-content-around h-100 shadow-sm p-4 mb-4">
              {% if ride.driver == app.user or is_granted('ROLE_EMPLOYEE') %}
                <h2>Passager(s)</h2>
              {% endif %}
              <p class="text-center mb-0">Il reste
                {{ ride.availableSeats }}
                places.</p>
              {% if ride.driver == app.user or is_granted('ROLE_EMPLOYEE') %}
                {% for booking in ride.rideBookings %}

                  {% if booking.status !== constant('App\\Enum\\BookingStatus::CANCELLED') %}
                    <div class="card d-flex flex-column flex-md-row justify-content-between mb-2 p-3">
                      <div class="d-flex flex-column flex-md-row align-items-center gap-4">
                        <p class="mb-0">{{ booking.passenger.login }}</p>
                        <p class="mb-0">{{ booking.passenger.email }}</p>
                      </div>
                    </div>
                  {% endif %}
                  {% if is_granted('ROLE_EMPLOYEE') %}
                    <div class="d-flex">
                      <a class="btn w-100" href="{{ path('app_user_show', {'id': booking.passenger.id}) }}" target="_blank">Voir</a>
                    </div>
                  {% endif %}
                {% else %}
                  <p class="text-center">Aucun passager</p>
                {% endfor %}
              {% endif %}
            </div>
          </div>


        </div>
      </div>
    </section>
  </main>
{% endblock %}

{% extends 'base.html.twig' %}

{% block title %}Ride
{% endblock %}

{% block body %}
	<main class="py-5">
		<section class="container-fluid">
			<div class="container">
				<div class="row justify-content-center">
					<div class="col-12">
						<h1>Récapitulatif</h1>
					</div>

					<!-- Partie trajet -->
					<div class="col-12 col-md-8">
						<div
							class="card justify-content-around h-100 flex-column shadow-sm p-4 mb-4">

							<!-- ref + statut réservation -->
							<div class="d-flex flex-column flex-md-row justify-content-between align-items-center p-2">
								<h2 class="my-2">Trajet #{{ ride.id }}</h2>
								<h3 class="my-2">{{ ride.status.value }}</h3>
							</div>

							<!-- Dates et heures -->
							<div class="d-flex flex-column p-2">
								<div class="d-flex flex-column flex-md-row gap-2">
									<p>Depart de
										{{ ride.departurePlace}}</p>
									<p>le
										{{ ride.departureDate ? ride.departureDate|date('d/m/Y') : ''}}</p>
									<p>à XXhXX</p>
								</div>

								<div class="d-flex flex-column flex-md-row gap-2">
									<p>Arrivée à
										{{ ride.arrivalPlace}}</p>
									<p>
										le
										{{ ride.departureDate ? ride.departureDate|date('d/m/Y') : ''}}</p>
									<p>à XXhXX</p>
								</div>
							</div>

							<!--  -->
							<div class="d-flex flex-column flex-md-row p-2">
								<p>Effectuée le :
									{{ ride.createdAt ? ride.createdAt|date('Y-m-d H:i:s') : '' }}</p>
							</div>

							<!-- Boutons d'action - A FAIRE REMPLACER PAR UNE COMPOSANT BTN -->
							<div class="d-flex flex-column flex-md-row justify-content-evently">

								{% if ride.status == constant('App\\Enum\\RideStatus::CONFIRMED') and ride.departureDate|date('Y-m-d') < 'now'|date('Y-m-d') %}
									<a class="btn m-2" href="">Annuler</a>
								{% elseif ride.status == constant('App\\Enum\\RideStatus::CONFIRMED') and ride.departureDate|date('Y-m-d') == 'now'|date('Y-m-d') %}
									<a class="btn m-2" href="">Demarrer</a>
								{% elseif ride.status == constant('App\\Enum\\RideStatus::RUNNING') %}
									<a class="btn m-2" href="">Arrêter</a>
								{% endif %}
							</div>
						</div>
					</div>

					<!-- Partie passagers -->
					<div class="col-12 col-md-4">

						<div class="card justify-content-around h-100 shadow-sm p-4 mb-4">
							<h2 class="my-2">Passager(s)
							</h2>
              {% for booking in ride.rideBookings %}
							<div class="d-flex flex-column align-items-center">
								<p>{{ booking.passenger.login }} Login</p>
								<p>{{ booking.passenger.email }}</p>
							</div>
              {% else %}
              <p class="text-center">Aucun passager</p>
              {% endfor %}
						</div>
					</div>

					<!-- Retour -->
					<div class="col-12">
						{% if is_granted('ROLE_EMPLOYE') %}
							<div class="text-center m-3">
								<a class="btn" href="{{ path('app_booking_index') }}">Retour aux réservations</a>
							</div>
						{% else %}
							<div class="text-center m-3">
								<a class="btn" href="{{ path('app_dashboard_client', { id: app.user.id }) }}">Retour sur le compte</a>
							</div>
						{% endif %}
					</div>


				</div>
			</div>
		</section>
	</main>
{% endblock %}

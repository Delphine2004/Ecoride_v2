{% extends 'base.html.twig' %}

{% block title %}Ride index{% endblock %}

{% block body %}
    <h1>Ride index</h1>

    <table class="table">
        <thead>
            <tr>
                <th>Id</th>
                <th>DepartureDate</th>
                <th>DeparturePlace</th>
                <th>ArrivalDate</th>
                <th>ArrivalPlace</th>
                <th>Price</th>
                <th>AvailableSeats</th>
                <th>Status</th>
                <th>Commission</th>
                <th>CreatedAt</th>
                <th>UpdatedAt</th>
                <th>actions</th>
            </tr>
        </thead>
        <tbody>
        {% for ride in rides %}
            <tr>
                <td>{{ ride.id }}</td>
                <td>{{ ride.departureDate ? ride.departureDate|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ ride.departurePlace }}</td>
                <td>{{ ride.arrivalDate ? ride.arrivalDate|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ ride.arrivalPlace }}</td>
                <td>{{ ride.price }}</td>
                <td>{{ ride.availableSeats }}</td>
                <td>{{ ride.status }}</td>
                <td>{{ ride.commission }}</td>
                <td>{{ ride.createdAt ? ride.createdAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>{{ ride.updatedAt ? ride.updatedAt|date('Y-m-d H:i:s') : '' }}</td>
                <td>
                    <a href="{{ path('app_ride_show', {'id': ride.id}) }}">show</a>
                    <a href="{{ path('app_ride_edit', {'id': ride.id}) }}">edit</a>
                </td>
            </tr>
        {% else %}
            <tr>
                <td colspan="12">no records found</td>
            </tr>
        {% endfor %}
        </tbody>
    </table>

    <a href="{{ path('app_ride_new') }}">Create new</a>
{% endblock %}

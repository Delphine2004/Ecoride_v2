{% extends 'base.html.twig' %}

{% block title %}Utilisateurs
{% endblock %}

{% block body %}
	<main class="py-5">
		<h1>Utilisateurs</h1>

		{% for user in users %}
			<twig:UserCard user="{{ user }}"/>
		{% else %}
			<p class="text-center m-2">
				Aucun utilisateur pour le moment
			</p>
		{% endfor %}
	</main>

{% endblock %}

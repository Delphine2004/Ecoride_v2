{{ form_start(form, {'attr': {'novalidate':  true}}) }}
<div class="row g-3 justify-content-around my-3">

	{% if form.firstName is defined %}
		<div class="col-12 col-md-6 mb-3">
			{{ form_label(form.firstName) }}
			{{ form_widget(form.firstName, {attr: {class: 'form-control'}}) }}
			{{ form_errors(form.firstName) }}
		</div>
	{% endif %}

	{% if form.lastName is defined %}
		<div class="col-12 col-md-6 mb-3">
			{{ form_label(form.lastName) }}
			{{ form_widget(form.lastName, {attr: {class: 'form-control'}}) }}
			{{ form_errors(form.lastName) }}
		</div>
	{% endif %}

	{% if form.login is defined %}
		<div class="col-12 mb-3">
			{{ form_label(form.login) }}
			{{ form_widget(form.login, {attr: {class: 'form-control'}}) }}
			{{ form_errors(form.login) }}
		</div>
	{% endif %}

	{% if form.email is defined %}
		<div class="col-12 mb-3">
			{{ form_label(form.email) }}
			{{ form_widget(form.email, {attr: {class: 'form-control'}}) }}
			{{ form_errors(form.email) }}
		</div>
	{% endif %}

	{% if form.picture is defined %}
		<div class="col-12 mb-3">
			{{ form_label(form.picture) }}
			{{ form_widget(form.picture, {attr: {class: 'form-control'}}) }}
			{{ form_errors(form.picture) }}
		</div>
	{% endif %}

	{% if form.credit is defined %}
		<div class="col-12 mb-3">
			{{ form_label(form.credit) }}
			{{ form_widget(form.credit, {attr: {class: 'form-control'}}) }}
			{{ form_errors(form.credit) }}
		</div>
	{% endif %}

	{% if form.plainPassword is defined %}
		<div class="col-12 mb-3">
			{{ form_label(form.plainPassword) }}
			{{ form_widget(form.plainPassword, {attr: {class: 'form-control'}}) }}
			{{ form_errors(form.plainPassword) }}
		</div>
	{% endif %}

	{% if form.password is defined %}
		<div class="col-12 mb-3">
			{{ form_label(form.password.first) }}
			{{ form_widget(form.password.first, { attr: {class: 'form-control'}}) }}
			{{ form_errors(form.password.first) }}
		</div>
		<div class="col-12 mb-3">
			{{ form_label(form.password.second) }}
			{{ form_widget(form.password.second, {attr: {class: 'form-control'}}) }}
			{{ form_errors(form.password.second) }}
		</div>
	{% endif %}

	{% if form.agreeTerms is defined %}
		<div class="col-12 col-md-10 mb-3">
			<div class="form-check">
				{{ form_widget(form.agreeTerms, {'attr': {'class': 'form-check-input'}}) }}
				<label class="form-check-label">
					J'accepte le traitement de mes données conformément à la
					<a class="fw-bold" href="#">politique de confidentialité</a>.
				</label>
				{{ form_errors(form.agreeTerms) }}
			</div>
		</div>
	{% endif %}

	{% if form.licence is defined %}
		<div class="col-12 mb-3">
			{{ form_label(form.licence) }}
			{{ form_widget(form.licence, {attr: {class: 'form-control'}}) }}
			{{ form_errors(form.licence) }}
		</div>
	{% endif %}

	{% if form.cars is defined %}
		{% for carForm in form.cars %}
			{% if carForm.brand is defined %}
				<div class="col-12 col-md-6 mb-3">
					{{ form_label(carForm.brand) }}
					{{ form_widget(carForm.brand, {attr: {class: 'form-control'}}) }}
					{{ form_errors(carForm.brand) }}
				</div>
			{% endif %}

			{% if carForm.model is defined %}
				<div class="col-12 col-md-6 mb-3">
					{{ form_label(carForm.model) }}
					{{ form_widget(carForm.model, {attr: {class: 'form-control'}}) }}
					{{ form_errors(carForm.model) }}
				</div>
			{% endif %}

			{% if carForm.color is defined %}
				<div class="col-12 col-md-6 mb-3">
					{{ form_label(carForm.color) }}
					{{ form_widget(carForm.color, {attr: {class: 'form-control'}}) }}
					{{ form_errors(carForm.color) }}
				</div>
			{% endif %}

			{% if carForm.year is defined %}
				<div class="col-12 col-md-6 mb-3">
					{{ form_label(carForm.year) }}
					{{ form_widget(carForm.year, {attr: {class: 'form-control'}}) }}
					{{ form_errors(carForm.year) }}
				</div>
			{% endif %}

			{% if carForm.power is defined %}
				<div class="col-12 col-md-6 mb-3">
					{{ form_label(carForm.power) }}
					{{ form_widget(carForm.power, {attr: {class: 'form-control'}}) }}
					{{ form_errors(carForm.power) }}
				</div>
			{% endif %}

			{% if carForm.seats is defined %}
				<div class="col-12 col-md-6 mb-3">
					{{ form_label(carForm.seats) }}
					{{ form_widget(carForm.seats, {attr: {class: 'form-control'}}) }}
					{{ form_errors(carForm.seats) }}
				</div>
			{% endif %}

			{% if carForm.registrationNumber is defined %}
				<div class="col-12 col-md-6 mb-3">
					{{ form_label(carForm.registrationNumber) }}
					{{ form_widget(carForm.registrationNumber, {attr: {class: 'form-control'}}) }}
					{{ form_errors(carForm.registrationNumber) }}
				</div>
			{% endif %}

			{% if carForm.registrationDate is defined %}
				<div class="col-12 col-md-6 mb-3">
					{{ form_label(carForm.registrationDate) }}
					{{ form_widget(carForm.registrationDate, {attr: {class: 'form-control'}}) }}
					{{ form_errors(carForm.registrationDate) }}
				</div>
			{% endif %}

		{% endfor %}
	{% endif %}
</div>

<div class="row g-3 justify-content-around my-3">
	<div class="col-12 col-md-4 mb-3">
		<button class="btn w-100">{{ button_label|default('Enregistrer') }}</button>
	</div>
</div>
{{ form_end(form) }}

{% extends 'base.html.twig' %}

{% block title %}Historique
{% endblock %}

{% block body %}
	<main class="py-5">
		<section class="container-fluid">
			<div class="container">
				<div class="row justify-content-center">

					<div class="col-12 col-md-10 col-lg-8">
						<div class="text-center m-3">
							<a class="btn" href="{{ path('app_dashboard_client') }}">Retour sur le compte</a>
						</div>
					</div>

					<div class="col-12 col-md-10 col-lg-8">
						<div class="card shadow-sm m-3">
							<div class="card-header">
								<h1>Historique</h1>
							</div>

							<div class="card-body">
								<h2>Réservations</h2>

								{% for booking in bookings %}
									<twig:BookingCard :booking="booking" :user="user"/>
								{% else %}
									<p class="text-center">Aucune réservation</p>
								{% endfor %}

							</div>


							{% if is_granted('ROLE_DRIVER')%}
								<div class="card-body">
									<h2>Trajets</h2>

									{% for ride in rides %}
										<twig:RideActions :ride="ride"/>
									{% else %}
										<p class="text-center">Aucune réservation</p>
									{% endfor %}
								</div>
							{% endif %}
              
						</div>
					</div>

				</div>
			</section>
		</main>
	{% endblock %}

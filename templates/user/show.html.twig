{% extends 'base.html.twig' %}

{% block title %}Récapitulatif utilisateur
{% endblock %}

{% block body %}
	<main class="py-5">
		<section class="container-fluid">
			<div class="container">
				<div class="row justify-content-center">
					<div class="col-12">
						<h1>Information utilisateur</h1>
					</div>
					<!-- Info -->
					<div class="col-12">
						<div class="card justify-content-around h-100 shadow-sm p-4 mb-4">
							<div class="d-flex flex-column flex-md-row justify-content-center align-items-center gap-3">
								<p>Référence :
									{{ user.id }}</p>
							</div>
							<div class="d-flex flex-column flex-md-row justify-content-center align-items-center gap-3">
								{% if user.type == constant('App\\Enum\\Type::CLIENT') %}
									<p>{{ user.firstName }}
										{{ user.lastName }}</p>
								{% endif %}
								<p>{{ user.login }}</p>
							</div>
							<div class="d-flex flex-column flex-md-row justify-content-center align-items-center gap-3">
								<p>{{ user.email }}</p>
							</div>
							{% if user.type == constant('App\\Enum\\Type::CLIENT') %}
								<div class="d-flex flex-column flex-md-row justify-content-center align-items-center gap-3">
									<p>{{ user.credit }}
										crédit</p>
								</div>
							{% endif %}
							<!-- modification -->
							<div class="text-center m-3">
								<a class="btn" href="{{ path('app_user_edit', {'id': user.id}) }}">Modifier</a>
							</div>
						</div>
					</div>

				</div>
			</div>
		</section>
	</main>
{% endblock %}

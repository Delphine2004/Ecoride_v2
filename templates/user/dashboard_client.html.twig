{% extends 'base.html.twig' %}

{% block title %}Compte Client
{% endblock %}

{% block body %}
	<main class="py-5">
		<section class="container-fluid">
			<div class="container">
				<div class="row justify-content-center">

					<div class="col-12 col-md-10 col-lg-8">
						<div class="card shadow-sm m-3">

							<div class="d-flex flex-column m-2 ">
								<h1>Bonjour
									{{ user.firstName }}</h1>
								<div class="d-flex flex-column flex-md-row justify-content-around">
									<div class="d-flex flex-column">
										<p>image</p>
										<a class="btn mb-2" href="{{ path('app_user_picture', { id: user.id }) }}">Modifier</a>
									</div>
									<div class="d-flex flex-column">
										<p>{{ user.credit }}
											crédits</p>
										<a class="btn mb-2" href="{{ path('app_user_credit', { id: user.id }) }}">Ajouter</a>
									</div>
								</div>

							</div>
						</div>
						<div class="card shadow-sm m-3">

							<div class="d-flex flex-column flex-md-row justify-content-around align-items-md-center flex-wrap m-2">
								<a class="btn my-4" href="{{ path('app_user_edit', { id: user.id }) }}">Informations</a>
								<a class="btn my-4" href="{{ path('app_user_history', { id: user.id }) }}">Historique</a>
								{% if is_granted('ROLE_DRIVER') %}
									<a class="btn my-4" href="{{ path('app_ride_new') }}">Ajouter un trajet</a>
								{% else %}
									<a class="btn my-4" href="{{ path('app_user_driver', { id: user.id }) }}">Devenir conducteur</a>
								{% endif %}
							</div>
						</div>
					</div>


					<div class="col-12 col-md-10 col-lg-8">
						<div class="card shadow-sm m-3">
							<div class="card-header">
								<h2>Actions en attente</h2>
							</div>
							<div class="card-body">
								<h3>Réservations</h3>
								<ul>
									{% for booking in actionToDoBookings %}
										<li><twig:BookingActions booking="{{ booking }}"/>
										</li>
									{% else %}
										<li>Aucune réservation</li>
									{% endfor %}
								</ul>
							</div>

							<div class="card-body">
								<h3>Trajets</h3>
								<ul>
									{% for ride in actionToDoRides %}
										<li>
											<twig:RideActions ride="{{ ride }}"/>
										</li>
									{% else %}
										<li>Aucun trajet</li>
									{% endfor %}
								</ul>
							</div>

						</div>
					</div>


					<div class="col-12 col-md-10 col-lg-8">
						<div class="card shadow-sm m-3">
							<div class="card-header">
								<h2>A venir</h2>
							</div>
							<div class="card-body">
								<h3>Réservation(s)</h3>
								<ul>
									{% for booking in upcomingBookings %}
										<li><twig:BookingActions booking="{{ booking }}"/></li>
									{% else %}
										<li>Aucune réservation</li>
									{% endfor %}
								</ul>
							</div>

							<div class="card-body">
								<h2>Trajet(s)</h2>
								<ul>
									{% for ride in upcomingRides %}
										<li>
											<twig:RideActions ride="{{ ride }}"/>
										</li>
									{% else %}
										<li>Aucun trajet</li>
									{% endfor %}
								</ul>
							</div>
						</div>
					</div>

				</div>
			</div>
		</section>
	</main>
{% endblock %}

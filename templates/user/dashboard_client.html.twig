{% extends 'base.html.twig' %}

{% block title %}Compte Client
{% endblock %}

{% block body %}
	<main class="py-5">
		<section class="container-fluid">
			<div class="container">
				<div class="row justify-content-center">

					<div class="col-12 col-md-10 col-lg-8">
						<div class="card flex-column shadow-sm m-3">

							<div class="row flex-column flex-md-row justify-content-around align-items-md-center">
								<div class="col-12 col-md-6 order-md-2">
									<div class="d-flex flex-column align-items-md-center p-2 my-2">
										<h1>Bonjour
											{{ user.firstName }}</h1>
										<div class="d-flex flex-column ">
											<h4 class="text-center">{{ user.credit }}
												crédits</h4>
											<a class="btn my-4" href="{{ path('app_user_credit', { id: user.id }) }}">Ajouter</a>
										</div>
									</div>
								</div>
								<div class="col-12 col-md-6 order-md-1">
									<div class="d-flex flex-column align-items-center p-2 my-2">
										<div class="avatar m-2">
											<img src="{% if user.picture %} {{ asset('uploads/users/' ~ user.picture) }} {% else %} {{ asset('uploads/users/user-default.svg') }} {% endif %}" alt="avatar de {{ user.login }}">
										</div>
										<a class="btn my-2" href="{{ path('app_user_picture', { id: user.id }) }}">Modifier</a>
									</div>
								</div>
							</div>

						</div>

						<div class="card shadow-sm m-3">

							<div class="row flex-column flex-md-row justify-content-around align-items-md-center flex-wrap m-2">
								<div class="col-12 col-md-5">
									<a class="btn w-100 my-4" href="{{ path('app_user_edit', { id: user.id }) }}">Informations</a>
								</div>
								<div class="col-12 col-md-5">
									<a class="btn w-100 my-4" href="{{ path('app_user_history', { id: user.id }) }}">Historique</a>
								</div>

								{% if is_granted('ROLE_DRIVER') %}
									<div class="col-12 col-md-5">
										<a class="btn w-100 my-4" href="{{ path('app_ride_new') }}">Ajouter un trajet</a>
									</div>
									<div class="col-12 col-md-5">
										<a class="btn w-100 my-4" href="{{ path('app_car_index', { id: user.id }) }}">Voiture(s)</a>
									</div>

								{% else %}
									<div class="col-12 col-md-5">
										<a class="btn w-100 my-4" href="{{ path('app_user_driver', { id: user.id }) }}">Devenir conducteur</a>
									</div>

								{% endif %}

							</div>

						</div>
					</div>


					{% for label, messages in app.flashes %}
						<div class="col-12 col-md-10 col-lg-8">
							{% for message in messages %}
								<p class="fw-bold text-center m-3 alert alert-{{ label }}">
									{{ message }}
								</p>
							{% endfor %}
						</div>
					{% endfor %}

					<div class="col-12 col-md-10 col-lg-8">
						<div class="card shadow-sm m-3">
							<div class="card-header">
								<h2>Actions en attente</h2>
							</div>
							<div class="card-body">
								<h3>Réservation(s)</h3>

								{% for booking in actionToDoBookings %}
									<twig:BookingCard :booking="booking" :user="user"/>
								{% else %}
									<p class="text-center">Aucune réservation</p>
								{% endfor %}

							</div>


							{% if is_granted('ROLE_DRIVER')%}
								<div class="card-body">
									<h3>Trajet(s)</h3>

									{% for ride in actionToDoRides %}
										<twig:RideCard :ride="ride" :user="user"/>
									{% else %}
										<p class="text-center">Aucun trajet</p>
									{% endfor %}

								</div>
							{% endif %}
						</div>
					</div>


					<div class="col-12 col-md-10 col-lg-8">
						<div class="card shadow-sm m-3">
							<div class="card-header">
								<h2>A venir</h2>
							</div>
							<div class="card-body">
								<h3>Réservation(s)</h3>

								{% for booking in upcomingBookings %}
									<twig:BookingCard :booking="booking" :user="user"/>
								{% else %}
									<p class="text-center">Aucune réservation</p>
								{% endfor %}

							</div>

							{% if is_granted('ROLE_DRIVER')%}
								<div class="card-body">
									<h3>Trajet(s)</h3>
									{% for ride in upcomingRides %}
										<twig:RideCard :ride="ride" :user="user"/>
									{% else %}
										<p class="text-center">Aucun trajet</p>
									{% endfor %}
								</div>
							{% endif %}

						</div>
					</div>

				</div>
			</div>
		</section>
	</main>
{% endblock %}

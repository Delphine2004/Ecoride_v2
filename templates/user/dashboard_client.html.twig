{% extends 'base.html.twig' %}

{% block title %}Compte Client
{% endblock %}

{% block body %}
	<h1>Compte client</h1>
	<div>{{ user.email }}</div>

	<div>
		<h2>Réservations: actions en attente</h2>
		<ul>
			{% for booking in actionToDoBookings %}
				<li><twig:BookingActions booking="{{ booking }}"/>
				</li>
			{% else %}
				<li>Aucune réservation</li>
			{% endfor %}
		</ul>
	</div>
	<div>
		<h2>Trajets: actions en attente</h2>
		<ul>
			{% for ride in actionToDoRides %}
				<li>
					<twig:RideActions ride="{{ ride }}"/>
				</li>
			{% else %}
				<li>Aucun trajet</li>
			{% endfor %}
		</ul>
	</div>


	<div>
		<h2>Réservations à venir</h2>
		<ul>
			{% for booking in upcomingBookings %}
				<li><twig:BookingActions booking="{{ booking }}"/></li>
			{% else %}
				<li>Aucune réservation</li>
			{% endfor %}
		</ul>
	</div>
	<div>
		<h2>Trajets à venir</h2>
		<ul>
			{% for ride in upcomingRides %}
				<li>
					<twig:RideActions ride="{{ ride }}"/>
				</li>
			{% else %}
				<li>Aucun trajet</li>
			{% endfor %}
		</ul>
	</div>

{% endblock %}

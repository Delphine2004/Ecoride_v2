{% extends 'base.html.twig' %}

{% block title %}Booking
{% endblock %}

{% block body %}
	<main class="py-5">
		<section class="container-fluid">
			<div class="container">
				<div class="row justify-content-center">
					<div class="col-12">
						<h1>Récapitulatif</h1>
					</div>

					<!-- Partie trajet -->
					<div class="col-12 col-md-8">
						<div
							class="card justify-content-around h-100 flex-column shadow-sm p-4 mb-4">

							<!-- ref + statut réservation -->
							<div class="d-flex flex-column flex-md-row justify-content-between align-items-center p-2">
								<h2 class="my-2">Réservation #{{ booking.id }}</h2>
								<h3 class="my-2">{{ booking.status.value }}</h3>
							</div>

							<!-- Dates et heures -->
							<div class="d-flex flex-column p-2">
								<div class="d-flex flex-column flex-md-row gap-2">
									<p>Depart de
										{{ booking.ride.departurePlace}}</p>
									<p>le
										{{ booking.ride.departureDate ? booking.ride.departureDate|date('d/m/Y') : ''}}</p>
									<p>à XXhXX</p>
								</div>

								<div class="d-flex flex-column flex-md-row gap-2">
									<p>Arrivée à
										{{ booking.ride.arrivalPlace}}</p>
									<p>
										le
										{{ booking.ride.departureDate ? booking.ride.departureDate|date('d/m/Y') : ''}}</p>
									<p>à XXhXX</p>
								</div>
							</div>

							<!--  -->
							<div class="d-flex flex-column flex-md-row p-2">
								<p>Effectuée le :
									{{ booking.createdAt ? booking.createdAt|date('Y-m-d H:i:s') : '' }}</p>
							</div>

							<!-- Boutons d'action -->
              <!-- A FAIRE REMPLACER PAR UNE COMPOSANT BTN -->
							<div class="d-flex flex-column flex-md-row justify-content-evently">

								{% if booking.status == constant('App\\Enum\\BookingStatus::CONFIRMED') and booking.ride.departureDate|date('Y-m-d') < 'now'|date('Y-m-d') %}
									<a class="btn m-2" href="">Annuler</a>
								{% elseif booking.status == constant('App\\Enum\\BookingStatus::PENDING') %}
									<a class="btn m-2" href="">Signaler</a>
									<a class="btn m-2" href="">Confirmer</a>
								{% endif %}
							</div>
						</div>
					</div>

					<!-- Partie conducteur -->
					<div class="col-12 col-md-4">

						<div class="card justify-content-around h-100 shadow-sm p-4 mb-4">
							<h2 class="my-2">Conducteur
							</h2>
							<div class="d-flex flex-column align-items-center">
								<p>{{ booking.ride.driver.login }}
									Login</p>
								<p>Note</p>
								<a class="btn w-100" href="">Avis</a>
							</div>
						</div>

					</div>

					<!-- Retour -->
					<div class="col-12">
						{% if is_granted('ROLE_EMPLOYE') %}
							<div class="text-center m-3">
								<a class="btn" href="{{ path('app_booking_index') }}">Retour aux réservations</a>
							</div>
						{% else %}
							<div class="text-center m-3">
								<a class="btn" href="{{ path('app_dashboard_client', { id: app.user.id }) }}">Retour sur le compte</a>
							</div>
						{% endif %}
					</div>

				</div>
			</div>
		</section>
	</main>
{% endblock %}
